  "fixture_truth": {
    "construction": "先按逻辑位置 p ∈ [0, kv_len) 生成 K_true/V_true（CPU 种子化生成器，bf16），再按 canonical 映射散布：cache[l2p[p // b], p % b] = truth[p]；其余槽保持哨兵",
    "independent_verification": [
      "逐位置核对 physical[l2p[p // b], p % b] == logical[p]（K 与 V 两者，逐位置计数）",
      "核对每个逻辑块有效尾之后的槽仍为哨兵（K 与 V 两者，逐位置计数）",
      "核对缓存中不存在任何『被读到但不是真值也不是哨兵』的位置"
    ],
    "distribution": {
      "main": "N(0, 1.0)（普通分布，不做放大；主用例与敏感负对照分开）",
      "sensitive_amplify": {
        "blocks": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "factor": 5.0,
        "applies_to": "仅 sensitive_counterexample 用例的被排除块"
      }
    },
    "sentinel": {
      "unwritten_value": 8.0,
      "purpose": "未写槽/尾块之后使用大幅哨兵；被读到即显著偏离，用于抓越读"
    },
    "seeds": [
      0,
      1,
      2
    ],
    "seed_policy": "每个用例在全部三个种子下运行并逐条保存；不换种子挑通过结果"
  },
  "reference_oracle": {
    "module": "src/attnview/gpuoracle.py（不 import 候选 gpukv，不读候选读表）",
    "derivation": "从语义输入（mode、refs、layout 的 sink/segment/local_window spans、prompt_len、attention_kv_len）独立构造逐位置布尔 mask；独立实现块外扩与因果上界（query_len=1 → 上界 = attention_kv_len-1）；不做 span 代数复用",
    "positions": "mask 块外扩后 = {p : p // b ∈ visible_blocks, p < attention_kv_len}，升序即后端读取顺序",
    "attention": "从逻辑真值 K_true/V_true 按上述位置 gather，FP32 显式计算 softmax(q·Kᵀ·scale)·V（逐 head 实现，GQA：q head h → kv head h // (H/KVH)）",
    "candidate_read_path": "候选必须走完整 KV 常驻 + block_table + seqused_k，不得 gather、不得每步重传",
    "expectations": "oracle 同时给出期望物理表 [l2p[b] for b in visible_blocks]、期望每块有效计数、期望 seqused_k 与期望写入位置，用于与候选数据面（阶段 03 ReadView）逐项比对"
  },
  "data_plane": {
    "source": "阶段 03 `attnview.readview.build_read_view`（TokenLayout/ViewInputs → ReadView）",
    "conversion": "ReadView.visible_blocks + physical_block_ids[:valid_counts] → 无 -1 读取表；seqused_k = Σ 可见 span 有效长度；填充不做 -1（FA2 不得收到 -1）",
    "expected_crosschecks": [
      "候选 visible_blocks == oracle visible_blocks",
      "候选物理表 == [l2p[b] for b in visible_blocks]",
      "候选 seqused_k == oracle 逐位置 mask 的有效计数",
      "候选 next_write_position == oracle 独立计算的下一写入位置",
      "当前 token 位置（attention_kv_len-1）必须在可见集合内（阶段 04 只承诺 query_len=1 且保留当前 token）"
    ]
  },
  "acceptance": {
    "gate": "所有判据（必需字段齐全、数值、oracle 自检、读取表有效性、数据面交叉核对、**配置预期块 == oracle == 候选**、K 与 V 内容不变、追加 slot（K 与 V 双侧，期望来自独立原位置公式）、常驻性（实际 data_ptr 观测）、行隔离、敏感度、越读负对照必须被本门禁拒绝）全部 PASS 才 exit 0",
    "aggregator": "src/attnview/gpucheck.py（纯函数，CPU 失败注入测试：tests/test_gpucheck.py）",
    "error_reporting": "保留完整错误信息（不只异常首行），并记录最差偏差位置与数值"
  },
