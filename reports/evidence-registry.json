{
 "version": 2,
 "note": "证据发布范围的唯一事实来源。改本文件后必须跑 python3 tools/pub-evidence-registry.py --write 重新生成 reports/evidence-index.md；--check 验证一致性、悬空引用、未声明重复与登记项是否真的被忽略。 扫描面为 `evidence/` 与 `logs/`；`vllm-patch/`（部署派生件，含被 run manifest 的 git_status_porcelain 引用的 deployed.json / orig/）与 `reports/`、`tools/` 的字节不属本登记表范围。",
 "archive_root": "/root/autodl-tmp/attnview-evidence-archive",
 "rule": [
  {
   "id": "R1",
   "text": "交付依据入库：被结论引用的 run 文本层（manifest / summary / arm / cleanup / force / engine-traces / error.txt / run 日志 / 源快照）入库。"
  },
  {
   "id": "R2",
   "text": "论证性失败件入库：失败尝试的目录与日志必须保留，不删、不改写。"
  },
  {
   "id": "R3",
   "text": "独立校验分两类：被结论引用的独立复算件入库；由监督/复核流程产出的过程记录（`*local-review*`）只登记 path + size + sha256，原件留归档目录（`registered_removed` 的 `independent-review`）。"
  },
  {
   "id": "R4",
   "text": "被取代代次只登记：同一实验的早期代次（结论已撤回或口径未定稿）字节不入库，只登记 path + size + sha256，原始字节归档在数据盘；撤回理由记在对应阶段的报告里，状态与哈希见 reports/evidence-index.md 的树外登记表。"
  },
  {
   "id": "R5",
   "text": "中间快照只登记：同一状态的多份刷新（环境探针等）只留首末两份，其余登记。"
  },
  {
   "id": "R6",
   "text": "明细只登记：逐位置/逐比较的原始明细以聚合段入库、明细只登记（聚合段自带明细的 size + sha256）；失败 run 的部分结构 dump 同样只登记，失败记录本身按 R2 入库。"
  },
  {
   "id": "R7",
   "text": "逐字节重复只保留一份（≥16 KiB 才值得摘出，小文件保留并在索引里标注同哈希）。例外：run 自带的源码快照是按协议冻结的逐 run provenance，允许重复，由 allow_duplicate 声明。"
  },
  {
   "id": "R8",
   "text": "未验收件不入库：尚未通过阶段验收的运行产物只登记为 pending，验收后按 R1 的 run 文本层入库。"
  },
  {
   "id": "R9",
   "text": "大件不入库：*.npz / *.npy / *.pt / *.bin / *.safetensors / *.gguf 与 >10 MB 的文件只登记 size + sha256；与任何文档逐条绑定的成员逐个登记，其余按组登记（glob + 组内文件数 + 合计字节）。"
  }
 ],
 "status_order": [
  "delivered",
  "independent-review",
  "superseded",
  "snapshot",
  "detail-only",
  "duplicate",
  "unclassified",
  "pending"
 ],
 "status_label": {
  "delivered": "随仓发行",
  "independent-review": "复核过程记录（树外登记）",
  "superseded": "被取代代次（树外登记）",
  "snapshot": "中间快照（树外登记）",
  "detail-only": "明细只登记（树外登记）",
  "duplicate": "重复副本（树外登记）",
  "unclassified": "未分类——门禁失败",
  "pending": "工作区未跟踪——入库前先分类"
 },
 "default_status": "unclassified",
 "rules": [
  {
   "glob": "evidence/p0-model/**",
   "status": "delivered",
   "note": "阶段 02 模型身份/配置/协议事实与冻结点"
  },
  {
   "glob": "evidence/before/**",
   "status": "delivered",
   "note": "阶段 01 环境探针基线段（未经 env.sh）"
  },
  {
   "glob": "evidence/after/**",
   "status": "delivered",
   "note": "阶段 01 环境探针最终态与 verify-runtime.sh 输出"
  },
  {
   "glob": "evidence/p1-cpu/**",
   "status": "delivered",
   "note": "阶段 03 CPU 侧夹具、prompt 保真与偏移记录"
  },
  {
   "glob": "evidence/p1-gpu-v6/**",
   "status": "delivered",
   "note": "阶段 04 交付依据轮（R2 提交时序合规）；v1–v5 见树外登记"
  },
  {
   "glob": "evidence/p2-single/**",
   "status": "delivered",
   "note": "阶段 05 部署事务与单请求校准"
  },
  {
   "glob": "evidence/p3-calib/**",
   "status": "delivered",
   "note": "阶段 05 校准 run 文本层与独立复算（含 oracle 聚合段）"
  },
  {
   "glob": "evidence/p3-masked-smoke/**",
   "status": "delivered",
   "note": "stage-05 masked 冒烟；验收状态见 reports/p3-calib/evidence-index.md §0（capture/structure.json 与 steps.jsonl 是否降为 detail-only 待验收裁定）"
  },
  {
   "glob": "evidence/*.log",
   "status": "delivered",
   "note": "环境与迁移记录"
  },
  {
   "glob": "evidence/*.txt",
   "status": "delivered",
   "note": "环境与迁移记录"
  },
  {
   "glob": "logs/**",
   "status": "delivered",
   "note": "安装与 serve 日志（含三次失败尝试原日志）"
  }
 ],
